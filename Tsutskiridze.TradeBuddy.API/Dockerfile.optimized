# --------------------------------------------
# Stage 1: Build
# --------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Set PATH so that dotnet global tools (like Playwright CLI) are available
ENV PATH="/root/.dotnet/tools:${PATH}"

# 1. Install build-stage dependencies BEFORE copying project files
#    so this layer is re-used as long as apt packages don't change.
RUN apt-get update && apt-get install -y wget unzip \
    && rm -rf /var/lib/apt/lists/*

# 2. Copy project files for NuGet restore.
#    (If you have .sln or multiple csproj, copy those too.)
COPY ["Tsutskiridze.TradeBuddy.API.csproj", "Tsutskiridze.TradeBuddy.API/"]
COPY ["Tsutskiridze.TradeBuddy.Application/", "Tsutskiridze.TradeBuddy.Application/"]
COPY ["Tsutskiridze.TradeBuddy.Infrastructure/", "Tsutskiridze.TradeBuddy.Infrastructure/"]

# 3. Restore NuGet packages. If csproj is unchanged, this layer remains cached.
RUN dotnet restore "Tsutskiridze.TradeBuddy.API/Tsutskiridze.TradeBuddy.API.csproj"

WORKDIR /src/Tsutskiridze.TradeBuddy.API

# 4. Copy the local tool manifest (so dotnet tool restore can find it)
COPY [".config/dotnet-tools.json", ".config/"]

# 5. Restore the local tools (includes Microsoft.Playwright.CLI if that's in your manifest)
RUN dotnet tool restore

# 6. Now copy the rest of your source code
COPY . .

# 7. Build your project. This ensures Microsoft.Playwright assemblies are present.
RUN dotnet build --no-restore -c Release

# 8. Now that the app is built (and Microsoft.Playwright is compiled), install Chromium
#    using the local Playwright CLI. Then copy the browser cache out.
RUN dotnet tool run playwright install chromium
RUN mkdir -p /app && cp -R /root/.cache/ms-playwright /app/ms-playwright

# 9. Finally, publish your application
RUN dotnet publish -c Release -o /app/build

# --------------------------------------------
# Stage 2: Runtime
# --------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Create a non-root user and group if it doesn't exist
RUN if ! getent group app > /dev/null; then groupadd -g 1001 app; fi && \
    if ! id -u app > /dev/null 2>&1; then useradd -m -u 1001 -g app app; fi

# Install OS-level dependencies required by Chromium and Playwright at runtime
RUN apt-get update && apt-get install -y \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libdrm2 libxcomposite1 \
    libxdamage1 libxrandr2 libcups2 libgbm1 libasound2 \
    libpangocairo-1.0-0 libpango-1.0-0 libxshmfence1 \
    libxfixes3 libxkbcommon0 wget unzip && \
    rm -rf /var/lib/apt/lists/*

# Copy the published app from build image
COPY --from=build /app/build .
# Copy Playwright's cached browser binaries
COPY --from=build /app/ms-playwright /app/ms-playwright

# Adjust permissions for the non-root user
RUN chown -R app:app /app

# Let Playwright know where the browsers live
ENV PLAYWRIGHT_BROWSERS_PATH=/app/ms-playwright

# Switch to non-root user
USER app

# Expose the desired port and set the application entrypoint
EXPOSE 80
ENTRYPOINT ["dotnet", "Tsutskiridze.TradeBuddy.API.dll"]
        