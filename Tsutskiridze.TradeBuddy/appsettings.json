{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Smtp": {
    "User": "your-smtp-user",
    "Password": "your-smtp-password",
    "Host": "smtp.host.com",
    "Port": "587",
    "EnableSsl": "True"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173,http://localhost:5000"
  },
  "AlphaVantage": {
    "ApiKey": "your-alphavantage-api-key"
  }
}
