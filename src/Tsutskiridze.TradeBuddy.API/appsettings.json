{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "System.Net.Http.HttpClient.LogicalHandler": "Warning",
      "System.Net.Http.HttpClient.ClientHandler": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "db-connection"
  },
  "AllowedHosts": "*",
  "Smtp": {
    "User": "your-smtp-user",
    "Password": "your-smtp-password",
    "Host": "smtp.host.com",
    "Port": "587",
    "EnableSsl": "True"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173,http://localhost:5000"
  },
  "AlphaVantage": {
    "ApiKey": "your-alphavantage-api-key",
    "BaseUrl": "https://www.alphavantage.co"
  },
  "Fmp": {
    "ApiKey": "your-fmp-api-key",
    "BaseUrl": "https://financialmodelingprep.com"
  },
  "Reddit": {
    "SearchEndpoint": "https://oauth.reddit.com/search.json",
    "AuthEndpoint": "https://www.reddit.com/api/v1/access_token",
    "ClientId": "your-reddit-client-id",
    "ClientSecret": "your-reddit-client-secret",
    "Username": "your-reddit-username",
    "Password": "your-reddit-password",
    "UserAgent": "your-reddit-user-agent"
  },
  "Finnhub": {
    "BaseUrl": "https://finnhub.io",
    "ApiKey": "your-fin-hub-api-key"
  },
  "Yahoo": {
    "BaseUrl": "https://finance.yahoo.com",
    "Query2ApiUrl": "https://query2.finance.yahoo.com"
  },
  "AI": {
    "Gemini": {
      "ApiKey": "your-api-key",
      "ModelID": "gemini-1.5-pro"
    },
    "OpenAI": {
      "ApiKey": "your-api-key",
      "ModelID": "gpt-4o-mini"
    }
  },
  "Telegram": {
    "BotToken": "your-telegram-bot-token",
    "GroupChatID": "",
    "PersonalChatID": ""
  },
  "RateLimits": {
    "Enabled": true,
    "Policies": {
      "StockAnalysisRequest": {
        "Enabled": true,
        "PartitionScope": "UserAndCommand",
        "PermitCost": 1,
        "Rules": [
          {
            "Algorithm": "FixedWindow",
            "PermitLimit": 100,
            "Window": "1.00:00:00"
          },
          {
            "Algorithm": "TokenBucket",
            "PermitLimit": 1,
            "TokensPerPeriod": 1,
            "ReplenishmentPeriod": "00:00:15"
          }
        ]
      }
    }
  }
}
