# --------------------------------------------
# Stage 1: Build - Focused on .NET Compilation/Publish
# --------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# 1. Install minimal build-stage dependencies (if any specific are needed beyond SDK)
#    (wget/unzip removed as Playwright install is moved)
# RUN apt-get update && apt-get install -y --no-install-recommends <any_build_specific_tools_here> \
#     && rm -rf /var/lib/apt/lists/*

# 2. Copy project files for NuGet restore.
COPY ["Tsutskiridze.TradeBuddy.API/Tsutskiridze.TradeBuddy.API.csproj", "Tsutskiridze.TradeBuddy.API/"]
COPY ["Tsutskiridze.TradeBuddy.Application/Tsutskiridze.TradeBuddy.Application.csproj", "Tsutskiridze.TradeBuddy.Application/"]
COPY ["Tsutskiridze.TradeBuddy.Infrastructure/Tsutskiridze.TradeBuddy.Infrastructure.csproj", "Tsutskiridze.TradeBuddy.Infrastructure/"]
COPY ["Tsutskiridze.TradeBuddy.Core/Tsutskiridze.TradeBuddy.Core.csproj", "Tsutskiridze.TradeBuddy.Core/"]
# If using a .sln file, copying it first is often better:
# COPY Tsutskiridze.TradeBuddy.sln ./
# RUN dotnet restore Tsutskiridze.TradeBuddy.sln

# 3. Restore NuGet packages.
RUN dotnet restore "Tsutskiridze.TradeBuddy.API/Tsutskiridze.TradeBuddy.API.csproj"

# 4. Copy the rest of your source code
COPY . .

# 5. Build your project (Build is implicitly done by Publish)
#    We can often skip the separate build step if publish does it.
# RUN dotnet build "Tsutskiridze.TradeBuddy.API/Tsutskiridze.TradeBuddy.API.csproj" --no-restore -c Release

# 6. Publish your application
WORKDIR /src/Tsutskiridze.TradeBuddy.API
RUN dotnet publish "Tsutskiridze.TradeBuddy.API.csproj" -c Release -o /app/publish --no-restore --self-contained false --no-build # Assuming you are not using self-contained

# --------------------------------------------
# Stage 2: Runtime - Prepares final environment + Installs Playwright
# --------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Create non-root user first
RUN groupadd -g 1001 app && \
    useradd -m -u 1001 -g app app

# Set PATH so Playwright CLI (installed globally later) is found
ENV PATH="/root/.dotnet/tools:${PATH}"

# Install OS dependencies for ASP.NET Core Runtime AND Playwright/Chromium
# Added ca-certificates as they are often needed for downloads/https connections
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libdrm2 libxcomposite1 \
    libxdamage1 libxrandr2 libcups2 libgbm1 libasound2 \
    libpangocairo-1.0-0 libpango-1.0-0 libxshmfence1 \
    libxfixes3 libxkbcommon0 wget unzip ca-certificates \
    # Install dotnet-sdk-8.0 temporarily ONLY to get the 'dotnet tool install' command
    dotnet-sdk-8.0 \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright CLI globally (needs SDK temporarily)
RUN dotnet tool install --global Microsoft.Playwright.CLI

# Define where Playwright should store browsers BEFORE installing
# Using /app/ms-playwright to keep it within the app dir and manage permissions easily
ENV PLAYWRIGHT_BROWSERS_PATH=/app/ms-playwright

# Install the specific browser needed by Playwright
# This will download Chromium to /app/ms-playwright
RUN playwright install chromium --with-deps

# Remove the temporarily installed SDK to keep the image lean
RUN apt-get purge -y --auto-remove dotnet-sdk-8.0 && \
    rm -rf /var/lib/apt/lists/*

# Copy the published app from the build stage
COPY --from=build /app/publish .

# Set ownership for the app directory (including the downloaded browser)
# Do this AFTER copying app and installing browser
RUN chown -R app:app /app

# Switch to non-root user
USER app

# Expose the desired port and set the application entrypoint
EXPOSE 80
ENTRYPOINT ["dotnet", "Tsutskiridze.TradeBuddy.API.dll"]